<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <ProjectReference Include="../../demos/DemoNodes/DemoNodes.csproj" />
    <!-- Test the real browser services on the host, without a browser-wasm test runner. -->
    <Compile Include="../../demos/FSMDemo.Wasm/Services/DemoRuntime.cs" Link="Services/DemoRuntime.cs" />
    <Compile Include="../../demos/FSMDemo.Wasm/Services/BrowserNodeFactory.cs" Link="Services/BrowserNodeFactory.cs" />
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>
</Project>
