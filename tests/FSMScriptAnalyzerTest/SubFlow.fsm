import Support;
module Original as SubFlow {
    input Entry, Retry;
    output Done, Failed;
    def Entry(TestAcc) { success -> Next; error -> Failed; }
    def Retry as TestIdle state { success -> Done; failed -> Done; }
    def Private(TestIdle) {
        success -> Done;
        Color: "https://example.invalid/*literal*/ import Missing;";
    }
    Next -> Entry to Private;
}
