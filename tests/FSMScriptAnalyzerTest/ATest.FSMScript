// Definition reuse only: not a replacement for parallel joins or child lifecycles.
module Wrapper {
    input Entry;
    output Done;
    def Entry(Start) { 1->Next; }
    def Exit(Start) { 1->Done; }
    Next -> Entry to Exit;
}
