<Window x:Class="OneStateDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OneStateDemo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="初始化" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Click="Button_Click" Height="45"/>
        <Button Content="执行" HorizontalAlignment="Left" Margin="178,10,0,0" VerticalAlignment="Top" Width="120" Click="Button_Click_1" Height="45"/>
        <Button Content="暂停" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="120" Click="Button_Click_2" Height="45"/>
        <Button Content="模拟异常" HorizontalAlignment="Left" Margin="512,10,0,0" VerticalAlignment="Top" Width="120" Click="Button_Click_3" Height="45"/>
        <Button Content="取消异常" HorizontalAlignment="Left" Margin="670,10,0,0" VerticalAlignment="Top" Width="120" Click="Button_Click_4" Height="45"/>
        <TextBlock Name="Info" HorizontalAlignment="Left" Margin="10,130,0,0" TextWrapping="Wrap" Text="StepMessage" VerticalAlignment="Top" Height="22" Width="575"/>
    </Grid>
</Window>
