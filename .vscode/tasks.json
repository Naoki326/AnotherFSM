{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/demos/FSMDemo.API/FSMDemo.API.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-browser",
      "command": "bash",
      "type": "process",
      "args": ["tools/build-browser.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile"
    }
  ]
}
