{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AnotherFSM API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/demos/FSMDemo.API/bin/Debug/net10.0/FSMDemo.API.dll",
      "args": ["--urls", "http://localhost:5079"],
      "cwd": "${workspaceFolder}/demos/FSMDemo.API",
      "console": "internalConsole"
    },
    {
      "name": "React WASM (run just wasm first)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5180/AnotherFSM/",
      "webRoot": "${workspaceFolder}/demos/FSMDemo.Frontend"
    }
  ]
}
